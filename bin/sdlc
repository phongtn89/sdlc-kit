#!/usr/bin/env python3
"""sdlc: render the portable SDLC agent kit into a project (see adapters/RENDERING.md)."""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys

BEGIN = "<!-- BEGIN sdlc-kit (managed; edit .sdlc/config.json or the kit instead) -->"
END = "<!-- END sdlc-kit -->"
BLOCK_RE = re.compile(re.escape(BEGIN) + r"\n(.*?)\n" + re.escape(END), re.S)
IMPORT_RE = re.compile(r"^[ \t]*@AGENTS\.md[ \t]*$", re.M)
ALL_TARGETS = ["claude", "copilot"]
TRACKS = [
    ("T0 Trivial", "no behaviour change: do, verify."),
    ("T1 Bug", "reproduce, root cause, failing test, fix, verify (sdlc-debug)."),
    ("T2 Change", "one session, one seam, no contract/data/security change: mini-spec, TDD, review, ship."),
    ("T3 Feature", "new behaviour, contract, data model, security-sensitive or >1 seam: specify, clarify, plan, tasks, analyze, human approval, implement, converge, review, ship."),
    ("T4 Initiative", "several features/teams/repos: grill, prd, ADRs, split into T3 features."),
]
SKILL_KEYS = {"name", "description", "argument-hint", "user-invocable", "disable-model-invocation"}
SKILL_BOOLS = {"user-invocable", "disable-model-invocation"}
ROLE_KEYS = {"name", "description", "access", "checks"}
SKILL_SECTIONS = ["## When to use", "## Process", "## Rationalizations", "## Red flags", "## Verification"]
SHARED_DIRS = ["checklists", "templates"]


class SdlcError(Exception):
    pass


# ---------------------------------------------------------------- helpers

def sha(data):
    return hashlib.sha256(data).hexdigest()


def read_bytes(path):
    with open(path, "rb") as f:
        return f.read()


def read_text(path):
    return read_bytes(path).decode("utf-8")


def load_json(path, what):
    try:
        return json.loads(read_text(path))
    except (OSError, ValueError) as e:
        raise SdlcError("cannot read %s (%s): %s" % (what, path, e))


def version_tuple(v):
    try:
        return tuple(int(x) for x in v.strip().split("."))
    except ValueError:
        return (0,)


def parse_frontmatter(text):
    """Strict subset. Returns (dict key -> value, body, errors).
    Values: str, or bool for bare true/false. Quoted strings are unescaped."""
    errors = []
    if not text.startswith("---\n"):
        return {}, text, ["missing frontmatter"]
    lines = text.split("\n")
    end = None
    for i in range(1, len(lines)):
        if lines[i] == "---":
            end = i
            break
    if end is None:
        return {}, text, ["unterminated frontmatter"]
    fm = {}
    for n, line in enumerate(lines[1:end], 2):
        if not line.strip():
            continue
        m = re.match(r"^([A-Za-z][A-Za-z0-9_-]*):[ ]*(.*?)\s*$", line)
        if not m:
            errors.append("line %d: not 'key: value' (lists are not allowed)" % n)
            continue
        key, raw = m.groups()
        if key in fm:
            errors.append("line %d: duplicate key %s" % (n, key))
            continue
        if raw.startswith('"'):
            q = re.match(r'^"((?:[^"\\]|\\.)*)"$', raw)
            if not q:
                errors.append("line %d: malformed quoted string" % n)
                continue
            fm[key] = re.sub(r"\\(.)", r"\1", q.group(1))
        elif raw in ("true", "false"):
            fm[key] = raw == "true"
        elif raw == "" or raw[0] in "[{-|>&*!":
            errors.append("line %d: %s must be a bare word, true/false or a quoted string" % (n, key))
        elif '"' in raw:
            errors.append("line %d: stray quote in %s" % (n, key))
        else:
            fm[key] = raw
    body = "\n".join(lines[end + 1:])
    return fm, body, errors


def yaml_scalar(v):
    unsafe = (": " in v or " #" in v or v.endswith(":") or not v or v[0] in "-?:,[]{}#&*!|>'\"%@`"
              or v in ("true", "false"))
    return json.dumps(v, ensure_ascii=False) if unsafe else v


def safe_path(target, rel):
    """Join rel under target; refuse anything that would escape it."""
    if not isinstance(rel, str) or not rel or os.path.isabs(rel) or "\\" in rel:
        raise SdlcError("unsafe path: %r" % (rel,))
    parts = rel.split("/")
    if any(p in ("", ".", "..") for p in parts):
        raise SdlcError("unsafe path: %r" % (rel,))
    full = os.path.join(target, *parts)
    real_t = os.path.realpath(target)
    real_f = os.path.realpath(full)
    if real_f != real_t and not real_f.startswith(real_t + os.sep):
        raise SdlcError("path escapes target: %r" % (rel,))
    return full


def write_file(target, rel, data):
    full = safe_path(target, rel)
    os.makedirs(os.path.dirname(full), exist_ok=True)
    with open(full, "wb") as f:
        f.write(data)


def prune_dirs(target, rel):
    d = os.path.dirname(safe_path(target, rel))
    real_t = os.path.realpath(target)
    while os.path.realpath(d) != real_t and os.path.realpath(d).startswith(real_t + os.sep):
        try:
            os.rmdir(d)
        except OSError:
            break
        d = os.path.dirname(d)


def check_target(path):
    if not os.path.isdir(path):
        raise SdlcError("target is not an existing directory: %s" % path)
    return os.path.abspath(path)


def list_files(root):
    out = []
    for dp, dn, fn in os.walk(root):
        dn[:] = sorted(d for d in dn if d != "__pycache__")  # bytecode is never kit content
        for f in sorted(fn):
            if f.endswith(".pyc"):
                continue
            full = os.path.join(dp, f)
            out.append(os.path.relpath(full, root).replace(os.sep, "/"))
    return sorted(out)


def read_lock(target):
    p = os.path.join(target, ".sdlc", "lock.json")
    if not os.path.isfile(p):
        return None
    lock = load_json(p, "lock")
    for k in ("files", "blocks"):
        if not isinstance(lock.get(k), dict):
            raise SdlcError("invalid lock: %s" % k)
    lock.setdefault("targets", [])
    lock.setdefault("modules", [])
    lock.setdefault("settings", {})
    st = lock["settings"]
    if not isinstance(st, dict) or set(st) - {SETTINGS_REL} or not all(
            isinstance(v, dict) and isinstance(v.get("hooks"), dict) and isinstance(v.get("created"), bool)
            and all(isinstance(h, str) for h in v["hooks"].values()) for v in st.values()):
        raise SdlcError("invalid lock: settings")
    for rel in list(lock["files"]) + list(lock["blocks"]):  # the settings key is exact, and may be a symlink
        safe_path(target, rel)
    return lock


def read_config(target, kit=None):
    p = os.path.join(target, ".sdlc", "config.json")
    if os.path.isfile(p):
        return load_json(p, "config.json")
    if kit:
        return load_json(os.path.join(kit, "adapters", "config.default.json"), "default config")
    return {}


def extract_block(text):
    m = BLOCK_RE.search(text)
    return (m.group(1), m) if m else (None, None)


# ---------------------------------------------------------------- kit loading

def source_dirs(kit, modules):
    return [os.path.join(kit, "core")] + [os.path.join(kit, "modules", m) for m in modules]


def load_kit(kit, modules):
    """Return dict with skills, roles, shared docs (all as bytes) from core + modules."""
    for m in modules:
        if not os.path.isdir(os.path.join(kit, "modules", m)):
            raise SdlcError("unknown module: %s" % m)
    skills, roles, shared = {}, {}, {}
    rules = [(m, read_text(os.path.join(kit, "modules", m, "rules.md")).strip("\n")) for m in modules
             if os.path.isfile(os.path.join(kit, "modules", m, "rules.md"))]
    cpath = os.path.join(kit, "core", "constitution.md")
    if not os.path.isfile(cpath):
        raise SdlcError("kit has no core/constitution.md")
    constitution = read_bytes(cpath)
    shared[".sdlc/constitution.md"] = constitution
    pdir = os.path.join(kit, "core", "principles")
    if os.path.isdir(pdir):
        for f in list_files(pdir):
            shared[".sdlc/principles/" + f] = read_bytes(os.path.join(pdir, f))
    for src in source_dirs(kit, modules):
        sdir = os.path.join(src, "skills")
        if os.path.isdir(sdir):
            for name in sorted(os.listdir(sdir)):
                d = os.path.join(sdir, name)
                if os.path.isdir(d) and os.path.isfile(os.path.join(d, "SKILL.md")):
                    files = {f: read_bytes(os.path.join(d, f)) for f in list_files(d)}
                    fm, _, _ = parse_frontmatter(files["SKILL.md"].decode("utf-8"))
                    skills[name] = {"files": files, "description": str(fm.get("description", ""))}
        rdir = os.path.join(src, "roles")
        if os.path.isdir(rdir):
            for f in sorted(os.listdir(rdir)):
                if f.endswith(".md"):
                    text = read_text(os.path.join(rdir, f))
                    fm, body, errs = parse_frontmatter(text)
                    if errs:
                        raise SdlcError("role %s: %s" % (f, "; ".join(errs)))
                    roles[f[:-3]] = {"fm": fm, "body": body}
        for kind in SHARED_DIRS:
            d = os.path.join(src, kind)
            if os.path.isdir(d):
                for f in list_files(d):
                    shared[".sdlc/%s/%s" % (kind, f)] = read_bytes(os.path.join(d, f))
    return {"skills": skills, "roles": roles, "shared": shared, "rules": rules,
            "constitution": constitution.decode("utf-8")}


def first_sentence(desc):
    desc = " ".join(desc.split())
    m = re.match(r"^(.*?[.!?])(\s|$)", desc)
    return (m.group(1) if m else desc).rstrip(".")


def block_inner(data, config):
    lines = data["constitution"].split("\n")
    idx = next((i for i, l in enumerate(lines) if l.startswith("# ")), -1)
    body = "\n".join(lines[idx + 1:]).strip("\n")
    out = [body, "", "## Index", "", "### Tracks", "", "| Track | Path |", "|---|---|"]
    out += ["| %s | %s |" % t for t in TRACKS]
    out += ["", "### Skills", ""]
    out += ["- **%s** — %s" % (n, first_sentence(data["skills"][n]["description"])) for n in sorted(data["skills"])]
    out += ["", "### Roles", ""]
    out += ["- **sdlc-%s** — %s" % (r, data["roles"][r]["fm"].get("description", "")) for r in sorted(data["roles"])]
    if data["rules"]:
        out += ["", "## Module rules"]
        for m, text in data["rules"]:
            out += ["", "### %s" % m, "", text]
    extra = [str(x) for x in config.get("extra_instructions", []) or []]
    if extra:
        out += ["", "## Project rules", ""] + ["- " + x for x in extra]
    return "\n".join(out)


def render_role(name, role, target, config, models):
    fm, body = role["fm"], role["body"]
    ro = fm.get("access") == "read-only"
    # A reviewing role (`checks: true`) gets Bash only when the bash hook is really in place and a check command is
    # configured: the hook is what limits that shell to the configured commands (spec 010).
    bash = (fm.get("checks") is True and config.get("_bash_hook_ok") is True
            and bool(hooks_module().check_commands(config)))  # used under `if ro:` only; lint keeps checks read-only
    lines = ["---", "name: sdlc-%s" % name, "description: %s" % yaml_scalar(str(fm.get("description", "")))]
    both = "claude" in config["_targets"]
    if target == "claude":
        if ro:
            lines.append("tools: Read, Grep, Glob" + (", Bash" if bash else ""))
        model = (config.get("models", {}).get("claude", {}) or {}).get(name) or models.get("claude", {}).get(name)
        if model:
            lines.append("model: %s" % model)
    else:
        lines.append("tools: ['read', 'search']" if ro else "tools: ['read', 'search', 'edit', 'execute', 'todo']")
        model = (config.get("models", {}).get("copilot", {}) or {}).get(name) or models.get("copilot", {}).get(name)
        if model:
            lines.append("model: %s" % model)
        if both:
            lines.append("target: github-copilot")
    lines.append("---")
    return ("\n".join(lines) + "\n" + body).encode("utf-8")


def render(kit, targets, modules, config, hooks_ok=False):
    """Return (files {rel: bytes}, blocks {rel: inner}). `hooks_ok`: the bash hook entry is in the settings the run
    leaves behind (spec 010); the roles marked `checks: true` may then be rendered with `Bash`."""
    data = load_kit(kit, modules)
    models = load_json(os.path.join(kit, "adapters", "models.json"), "models.json")
    cfg = dict(config)
    cfg["_targets"] = targets
    cfg["_bash_hook_ok"] = hooks_ok
    files = dict(data["shared"])
    blocks = {}
    inner = block_inner(data, config)
    for t in targets:
        if t == "claude":
            for n, s in data["skills"].items():
                for f, b in s["files"].items():
                    files[".claude/skills/%s/%s" % (n, f)] = b
            for r, role in data["roles"].items():
                files[".claude/agents/sdlc-%s.md" % r] = render_role(r, role, "claude", cfg, models)
            blocks["AGENTS.md"] = inner
        else:
            if "claude" not in targets:
                for n, s in data["skills"].items():
                    for f, b in s["files"].items():
                        files[".github/skills/%s/%s" % (n, f)] = b
            for r, role in data["roles"].items():
                files[".github/agents/sdlc-%s.agent.md" % r] = render_role(r, role, "copilot", cfg, models)
            blocks[".github/copilot-instructions.md"] = inner
    return files, blocks


# ---------------------------------------------------------------- install / update

def apply_block(text, inner):
    new = BEGIN + "\n" + inner + "\n" + END
    if BLOCK_RE.search(text):
        return BLOCK_RE.sub(lambda m: new, text, count=1)
    if text and not text.endswith("\n"):
        text += "\n"
    if text:
        text += "\n"
    return text + new + "\n"


def remove_block(text):
    m = BLOCK_RE.search(text)
    if not m:
        return text
    start, end = m.start(), m.end()
    if text[end:end + 1] == "\n":
        end += 1
    if start >= 2 and text[start - 2:start] == "\n\n":
        start -= 1
    elif start == 1 and text[0] == "\n":
        start = 0
    return text[:start] + text[end:]


def plan_claude_md(target, old):
    """Decide how CLAUDE.md gets its @AGENTS.md import. Returns (files_add, blocks_add)."""
    rel = "CLAUDE.md"
    full = safe_path(target, rel)
    if rel in old["blocks"]:
        return {}, {rel: "@AGENTS.md"}
    if not os.path.exists(full):
        return {rel: b"@AGENTS.md\n"}, {}
    cur = read_bytes(full)
    if IMPORT_RE.search(cur.decode("utf-8", "replace")):
        return ({rel: cur} if rel in old["files"] else {}), {}
    return {}, {rel: "@AGENTS.md"}


SETTINGS_REL = ".claude/settings.json"


def hooks_module():
    sys.dont_write_bytecode = True  # the kit folder must stay unwritten
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import sdlc_hooks
    return sdlc_hooks


def lists_bash(text):
    """Whether a role file's front matter names Bash under its tools key, in any YAML form (spec 010)."""
    m = re.match(r"---\n(.*?)\n---(?:\n|$)", text.replace("\r\n", "\n"), re.S)
    lines = m.group(1).split("\n") if m else []
    for i, line in enumerate(lines):
        if line.startswith("tools:"):
            value = [line[len("tools:"):]]
            for nxt in lines[i + 1:]:
                if nxt[:1] not in (" ", "\t", "-"):
                    break
                value.append(nxt)
            return "Bash" in re.findall(r"\w+", " ".join(value))
    return False


def roles_with_bash(target, planned=None):
    """The reviewing role files that list Bash: the text `planned` gives (None: removed), else the file on disk, also
    one the lock does not record (spec 010)."""
    found = []
    for role in hooks_module().CHECK_ROLES:
        rel = ".claude/agents/%s.md" % role
        if planned is not None and rel in planned:
            data = planned[rel]
        else:
            full = safe_path(target, rel)
            data = read_bytes(full) if os.path.isfile(full) else None
        if data is not None and lists_bash(data.decode("utf-8", "replace")):
            found.append(rel)
    return found


def settings_text_or_none(target):
    try:
        full = safe_path(target, SETTINGS_REL)
        return read_text(full) if os.path.isfile(full) else None
    except (SdlcError, OSError, UnicodeDecodeError):
        return None


def sync(target, kit, targets, modules, force, first):
    """Render into target. Returns (exit_code, report lines)."""
    old = read_lock(target) or {"files": {}, "blocks": {}}
    config = read_config(target, kit)
    hk = hooks_module()
    enforce = config.get("enforce") is True
    want = enforce and "claude" in targets and "repos" not in config
    s_old = old.get("settings", {}).get(SETTINGS_REL)
    s_full = s_text = s_error = None
    if want or s_old:  # the file is looked at only when hooks are wanted or were installed: other installs see no change
        try:
            s_full = safe_path(target, SETTINGS_REL)
            s_text = read_text(s_full) if os.path.isfile(s_full) else None
        except (SdlcError, OSError, UnicodeDecodeError) as e:
            s_error = str(e) if isinstance(e, SdlcError) else e.__class__.__name__
    if s_error:
        s_action, s_new, s_lock, s_lines, s_skipped = None, None, s_old, ["SKIP %s (%s)" % (SETTINGS_REL, s_error)], 1
    else:
        s_action, s_new, s_lock, s_lines, s_skipped = hk.settings_plan(
            s_text, want, os.path.join(os.path.realpath(kit), "bin", "sdlc"), s_old, force)
    # The settings text this run leaves behind decides whether a reviewing role may get Bash (spec 010).
    s_after = s_new if s_action == "write" else (None if s_action == "delete" else s_text)
    cli = os.path.join(os.path.realpath(kit), "bin", "sdlc")
    files, blocks = render(kit, targets, modules, config, hooks_ok=hk.bash_hook_ok(config, targets, s_after, cli))
    if "claude" in targets:
        f_add, b_add = plan_claude_md(target, old)
        files.update(f_add)
        blocks.update(b_add)
    out = list(s_lines)
    written = removed = 0
    skipped = s_skipped
    if enforce and "claude" not in targets:
        out.append("NOTE enforce: GitHub Copilot has no hook equivalent; use CI (see the docs)")
    elif enforce and "repos" in config:
        out.append("NOTE enforce: workspaces are not supported yet; no hook rendered")
    elif want and hk.commands_empty(config):
        out.append("NOTE enforce: commands is empty, so sdlc verify cannot pass and every push will be refused; "
                   "set commands in .sdlc/config.json")
    new_lock_files, new_lock_blocks = {}, {}
    conflicts = []
    actions = []  # (kind, rel, payload)

    for rel in sorted(files):
        data = files[rel]
        h = sha(data)
        full = safe_path(target, rel)
        exists = os.path.isfile(full)
        cur = sha(read_bytes(full)) if exists else None
        if exists and cur == h:
            new_lock_files[rel] = h
            continue
        if exists and not force:
            if rel in old["files"]:
                if cur != old["files"][rel]:
                    out.append("SKIP %s (modified locally)" % rel)
                    skipped += 1
                    new_lock_files[rel] = old["files"][rel]
                    continue
            else:
                conflicts.append(rel)
                continue
        actions.append(("write", rel, data))
        new_lock_files[rel] = h

    if first and conflicts:
        return 2, ["CONFLICT %s (exists, not managed; use --force)" % c for c in conflicts] + \
            ["conflicts: %d, nothing written" % len(conflicts)]
    for c in conflicts:
        out.append("SKIP %s (exists, not managed; use --force)" % c)
        skipped += 1

    for rel in sorted(blocks):
        inner = blocks[rel]
        full = safe_path(target, rel)
        text = read_text(full) if os.path.isfile(full) else ""
        cur_inner, _ = extract_block(text)
        h = sha(inner.encode("utf-8"))
        if cur_inner is not None and cur_inner == inner:
            new_lock_blocks[rel] = h
            continue
        if not force and rel in old["blocks"]:
            if cur_inner is None or sha(cur_inner.encode("utf-8")) != old["blocks"][rel]:
                out.append("SKIP %s (managed block modified locally)" % rel)
                skipped += 1
                new_lock_blocks[rel] = old["blocks"][rel]
                continue
        actions.append(("block", rel, inner))
        new_lock_blocks[rel] = h

    for rel in sorted(old["files"]):
        if rel in files:
            continue
        full = safe_path(target, rel)
        if not os.path.isfile(full):
            continue
        if sha(read_bytes(full)) == old["files"][rel] or force:
            actions.append(("remove", rel, None))
        else:
            out.append("KEPT %s (modified locally, no longer managed)" % rel)
    for rel in sorted(old["blocks"]):
        if rel not in blocks:
            actions.append(("unblock", rel, None))

    if not hk.bash_entry_ok(s_after, cli):  # a role file left alone that still lists Bash (spec 010)
        planned = {rel: (payload if kind == "write" else None) for kind, rel, payload in actions
                   if kind in ("write", "remove")}
        for rel in roles_with_bash(target, planned):
            out.append("NOTE %s lists Bash and the bash hook entry is not rendered; "
                       "run sdlc update --force or delete the file" % rel)
    if not os.path.exists(os.path.join(target, ".sdlc", "config.json")):
        write_file(target, ".sdlc/config.json", read_bytes(os.path.join(kit, "adapters", "config.default.json")))
        written += 1
    # The settings file goes first: a failed write then leaves the role files as they were, never a role with Bash and
    # no hook entry (spec 010).
    if s_action == "write":
        hk.write_atomic(s_full, s_new.encode("utf-8"))
        written += 1
    elif s_action == "delete":
        os.remove(s_full)
        prune_dirs(target, SETTINGS_REL)
        removed += 1
    for kind, rel, payload in actions:
        if kind == "write":
            write_file(target, rel, payload)
            written += 1
        elif kind == "block":
            full = safe_path(target, rel)
            text = read_text(full) if os.path.isfile(full) else ""
            write_file(target, rel, apply_block(text, payload).encode("utf-8"))
            written += 1
        elif kind == "remove":
            os.remove(safe_path(target, rel))
            prune_dirs(target, rel)
            removed += 1
        else:
            if drop_block(target, rel):
                removed += 1
    lock = {"kit_version": read_text(os.path.join(kit, "VERSION")).strip(), "kit_path": os.path.realpath(kit),
            "targets": targets,
            "modules": modules, "files": new_lock_files, "blocks": new_lock_blocks}
    if s_lock:
        lock["settings"] = {SETTINGS_REL: s_lock}
    write_file(target, ".sdlc/lock.json", (json.dumps(lock, indent=2, sort_keys=True) + "\n").encode("utf-8"))
    out.append("sdlc: written %d, skipped %d, removed %d" % (written, skipped, removed))
    return (2 if skipped else 0), out


def drop_block(target, rel):
    full = safe_path(target, rel)
    if not os.path.isfile(full):
        return False
    text = read_text(full)
    if not BLOCK_RE.search(text):
        return False
    new = remove_block(text)
    if new.strip():
        write_file(target, rel, new.encode("utf-8"))
    else:
        os.remove(full)
        prune_dirs(target, rel)
    return True


def parse_list(s, allowed=None, what="value"):
    items = sorted({x.strip() for x in s.split(",") if x.strip()})
    if allowed is not None:
        bad = [i for i in items if i not in allowed]
        if bad:
            raise SdlcError("unknown %s: %s" % (what, ", ".join(bad)))
    return items


def cmd_install(a, kit):
    target = check_target(a.dir)
    lock = read_lock(target)
    if a.targets is not None:
        targets = parse_list(a.targets, ALL_TARGETS, "target")
    else:
        targets = lock["targets"] if lock else list(ALL_TARGETS)
    modules = parse_list(a.modules, None, "module") if a.modules is not None else (lock["modules"] if lock else [])
    if not targets:
        raise SdlcError("no targets selected")
    return sync(target, kit, targets, modules, a.force, lock is None)


def cmd_update(a, kit):
    target = check_target(a.dir)
    lock = read_lock(target)
    if lock is None:
        raise SdlcError("not installed (no .sdlc/lock.json); run install")
    return sync(target, kit, lock["targets"], lock["modules"], a.force, False)


# ---------------------------------------------------------------- check / uninstall / next-spec

def spec_dirs(target, config):
    sd = config.get("spec_dir", "specs") or "specs"
    d = safe_path(target, sd.strip("/"))
    if not os.path.isdir(d):
        return []
    return sorted(n for n in os.listdir(d) if os.path.isdir(os.path.join(d, n)) and re.match(r"^\d{3}-", n))


def cmd_check(a, kit):
    target = check_target(a.dir)
    lock = read_lock(target)
    if lock is None:
        raise SdlcError("not installed (no .sdlc/lock.json)")
    out, drift = [], False
    for rel in sorted(lock["files"]):
        full = safe_path(target, rel)
        if not os.path.isfile(full):
            out.append("MISSING %s" % rel)
            drift = True
        elif sha(read_bytes(full)) != lock["files"][rel]:
            if rel == "CLAUDE.md" and IMPORT_RE.search(read_text(full)):
                continue
            out.append("MODIFIED %s" % rel)
            drift = True
    for rel in sorted(lock["blocks"]):
        full = safe_path(target, rel)
        if not os.path.isfile(full):
            out.append("MISSING %s" % rel)
            drift = True
            continue
        inner, _ = extract_block(read_text(full))
        if inner is None:
            out.append("DRIFT %s: managed block missing" % rel)
            drift = True
        elif sha(inner.encode("utf-8")) != lock["blocks"][rel]:
            out.append("DRIFT %s: managed block edited" % rel)
            drift = True
    config = read_config(target)
    hk = hooks_module()
    s_lock = lock["settings"].get(SETTINGS_REL)
    recorded = bool(s_lock and s_lock["hooks"])
    if recorded:
        try:
            s_full = safe_path(target, SETTINGS_REL)
            s_lines = hk.drift(read_text(s_full) if os.path.isfile(s_full) else None, s_lock)
        except (SdlcError, OSError, UnicodeDecodeError) as e:
            s_lines = ["DRIFT %s: cannot read it: %s" % (SETTINGS_REL, e if isinstance(e, SdlcError) else e.__class__.__name__)]
        out.extend(s_lines)
        drift = drift or bool(s_lines)
    if not hk.bash_entry_ok(settings_text_or_none(target), os.path.join(os.path.realpath(kit), "bin", "sdlc")):
        for rel in roles_with_bash(target):  # on disk, also unlocked: a shell no hook limits (spec 010)
            out.append("DRIFT %s: lists Bash and the bash hook entry is not intact" % rel)
            drift = True
    enforce = config.get("enforce") is True
    kit_path = lock.get("kit_path")
    if isinstance(kit_path, str) and not os.path.isdir(kit_path):
        if recorded or enforce:
            out.append("KIT-PATH-MISSING %s" % kit_path)
            drift = True
        else:
            out.append("NOTE KIT-PATH-MISSING %s" % kit_path)
    if enforce and not recorded and "claude" in lock["targets"] and "repos" not in config:
        out.append("NOTE enforce is true but the lock records no hooks (run update)")
    groups = {}
    for n in spec_dirs(target, config):
        groups.setdefault(n[:3], []).append(n)
    for prefix in sorted(groups):
        if len(groups[prefix]) > 1:
            out.append("DUPLICATE-SPEC %s: %s" % (prefix, ", ".join(groups[prefix])))
    kv = read_text(os.path.join(kit, "VERSION")).strip()
    lv = str(lock.get("kit_version", "0"))
    if version_tuple(lv) < version_tuple(kv):
        out.append("OUTDATED lock %s < kit %s (run update)" % (lv, kv))
    if not out:
        out.append("ok")
    return (1 if drift else 0), out


def cmd_uninstall(a, kit):
    target = check_target(a.dir)
    lock = read_lock(target)
    if lock is None:
        raise SdlcError("not installed (no .sdlc/lock.json)")
    out, removed = [], 0
    for rel in sorted(lock["files"]):
        full = safe_path(target, rel)
        if not os.path.isfile(full):
            continue
        if sha(read_bytes(full)) == lock["files"][rel]:
            os.remove(full)
            prune_dirs(target, rel)
            removed += 1
        else:
            out.append("KEPT %s (modified locally)" % rel)
    for rel in sorted(lock["blocks"]):
        if drop_block(target, rel):
            removed += 1
    s_lock = lock["settings"].get(SETTINGS_REL)
    if s_lock:
        try:
            s_full = safe_path(target, SETTINGS_REL)
            action, s_new, _, s_lines, _ = hooks_module().settings_plan(
                read_text(s_full) if os.path.isfile(s_full) else None, False, "", s_lock, False)
        except (SdlcError, OSError, UnicodeDecodeError) as e:
            action, s_lines = None, ["SKIP %s (%s)" % (SETTINGS_REL, e if isinstance(e, SdlcError) else e.__class__.__name__)]
        out.extend(s_lines)
        if action == "write":
            hooks_module().write_atomic(s_full, s_new.encode("utf-8"))
            removed += 1
        elif action == "delete":
            os.remove(s_full)
            prune_dirs(target, SETTINGS_REL)
            removed += 1
    os.remove(safe_path(target, ".sdlc/lock.json"))
    prune_dirs(target, ".sdlc/lock.json")
    out.append("sdlc: removed %d, kept config.json" % removed)
    return 0, out


def cmd_next_spec(a, kit):
    target = check_target(a.dir)
    nums = [int(n[:3]) for n in spec_dirs(target, read_config(target))]
    return 0, ["%03d" % (max(nums) + 1 if nums else 1)]


def cmd_verify(a, kit):
    sys.dont_write_bytecode = True  # the kit folder must stay unwritten
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import sdlc_verify
    try:
        target = check_target(a.dir)
        return sdlc_verify.run(target, read_config(target), a.repo, safe_path)
    except (SdlcError, sdlc_verify.VerifyError) as e:
        return 2, ["sdlc: error: %s" % e]


def cmd_gate(a, kit):
    sys.dont_write_bytecode = True  # the kit folder must stay unwritten
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import sdlc_gate
    try:
        target = check_target(a.dir)
        code, lines = sdlc_gate.run(target, read_config(target), a, safe_path)
    except (SdlcError, sdlc_gate.GateError, OSError, UnicodeDecodeError, ValueError) as e:
        return 2, ["sdlc: error: %s" % e]
    enc = sys.stdout.encoding or "utf-8"
    return code, [l.encode(enc, "replace").decode(enc) for l in lines]  # an encoding problem can't follow a write


def cmd_budget(a, kit):
    sys.dont_write_bytecode = True  # the kit folder must stay unwritten
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import sdlc_budget
    try:
        target = check_target(a.dir)
        return sdlc_budget.run(target, read_config(target), a, safe_path)
    except (SdlcError, sdlc_budget.BudgetError, OSError, UnicodeDecodeError, ValueError) as e:
        return 2, ["sdlc: error: %s" % e]


def cmd_hook(a, kit):
    """Run an enforcement hook (spec 006). The process exit code is always 0; a refusal is a message on stdout."""
    sys.dont_write_bytecode = True  # the kit folder must stay unwritten
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    try:
        import sdlc_hooks
        raw = sys.stdin.buffer.read(sdlc_hooks.INPUT_CAP + 1).decode("utf-8", "replace")
        out = sdlc_hooks.run(a.name, raw, os.environ, read_config, safe_path)
    except Exception as e:  # even an import failure must not block the host
        out = json.dumps({"systemMessage": "sdlc: hook %s skipped: %s" % (a.name, type(e).__name__)})
    enc = sys.stdout.encoding or "utf-8"
    if out:
        print(out.encode(enc, "replace").decode(enc))
    return 0, []


# ---------------------------------------------------------------- discover

LOCKFILES = ["bun.lockb", "bun.lock", "package-lock.json", "pnpm-lock.yaml", "yarn.lock"]
MANIFESTS = ["Makefile", "pyproject.toml", "go.mod", "Cargo.toml", "pom.xml", "build.gradle"]
SCRIPT_RE = re.compile(r"^(test|lint|typecheck|build|integration|validate|check)(:|$)|^test:integration")
SURFACES = [".specify", ".claude/skills", ".claude/agents", ".claude/commands", ".agents/skills",
            ".github/agents", ".github/prompts", ".codex", "skills-lock.json", "opencode.jsonc"]
CRED_RE = re.compile(r"^([a-z][a-z0-9+.-]*://)[^/@]*@", re.I)
BUILT_FROM_RE = re.compile(r"^Built from: `?([0-9a-f]{7,40})`?", re.M)


def git_read(repo, *args):
    """Read-only git query: no index refresh writes, and fsmonitor off so no repo-configured program runs."""
    try:
        p = subprocess.run(["git", "--no-optional-locks", "-c", "core.fsmonitor=false", "-C", repo] + list(args),
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return p.stdout.strip() if p.returncode == 0 else None


def line_count(path):
    return len(read_text(path).splitlines()) if os.path.isfile(path) else None


def speckit_version(repo):
    d = os.path.join(repo, ".specify")
    if not os.path.isdir(d):
        return None
    for n in sorted(os.listdir(d)):
        f = os.path.join(d, n)
        if n.endswith(".json") and os.path.isfile(f):
            try:
                v = json.loads(read_text(f)).get("speckit_version")
            except (ValueError, AttributeError):
                continue
            if v:
                return str(v)
    return None


def context_info(repo, ws):
    """Freshness of the workspace's .sdlc/context/<repo>.md against the repo HEAD."""
    rel = ".sdlc/context/%s.md" % os.path.basename(repo)
    path = os.path.join(ws, *rel.split("/"))
    if not os.path.isfile(path):
        return None
    m = BUILT_FROM_RE.search(read_text(path))
    built = m.group(1) if m else None
    behind = None
    if built:
        n = git_read(repo, "rev-list", "--count", built + "..HEAD")
        behind = int(n) if n and n.isdigit() else None
    return {"path": rel, "built_from": built, "stale": behind != 0, "commits_behind": behind}


def describe_repo(repo, ws):
    pkg = {}
    if os.path.isfile(os.path.join(repo, "package.json")):
        try:
            pkg = json.loads(read_text(os.path.join(repo, "package.json")))
        except ValueError:
            pkg = {}
    scripts = pkg.get("scripts") if isinstance(pkg.get("scripts"), dict) else {}
    lockfiles = [f for f in LOCKFILES if os.path.isfile(os.path.join(repo, f))]
    groups = {}
    for n in spec_dirs(repo, {}):
        groups.setdefault(n[:3], []).append(n)
    status = git_read(repo, "status", "--porcelain")
    remote = git_read(repo, "remote", "get-url", "origin")
    lock_path = os.path.join(repo, ".sdlc", "lock.json")
    sdlc_version = None
    if os.path.isfile(lock_path):
        try:
            sdlc_version = json.loads(read_text(lock_path)).get("kit_version")
        except ValueError:
            pass
    return {
        "name": os.path.basename(repo),
        "path": repo,
        "branch": git_read(repo, "branch", "--show-current"),
        "head": git_read(repo, "rev-parse", "--short", "HEAD"),
        "dirty": len(status.splitlines()) if status else 0,
        "remote": CRED_RE.sub(r"\1", remote) if remote else None,
        "package_manager": pkg.get("packageManager") or None,
        "lockfiles": lockfiles,
        "scripts": {k: v for k, v in sorted(scripts.items()) if SCRIPT_RE.search(k)},
        "manifests": [m for m in MANIFESTS if os.path.isfile(os.path.join(repo, m))],
        "ci_workflows": len([f for f in os.listdir(os.path.join(repo, ".github", "workflows"))
                             if f.endswith((".yml", ".yaml"))])
        if os.path.isdir(os.path.join(repo, ".github", "workflows")) else 0,
        "specs": {"dir": "specs", "count": sum(len(v) for v in groups.values()),
                  "duplicates": {k: v for k, v in sorted(groups.items()) if len(v) > 1}},
        "speckit_version": speckit_version(repo),
        "surfaces": [s for s in SURFACES if os.path.exists(os.path.join(repo, *s.split("/")))],
        "agents_md_lines": line_count(os.path.join(repo, "AGENTS.md")),
        "claude_md_lines": line_count(os.path.join(repo, "CLAUDE.md")),
        "sdlc_version": sdlc_version,
        "context": context_info(repo, ws),
    }


def cmd_discover(a, kit):
    ws = os.path.realpath(check_target(a.dir))
    repos = []
    for n in sorted(os.listdir(ws)):
        full = os.path.join(ws, n)
        if n == "node_modules" or os.path.islink(full) or not os.path.isdir(full):
            continue
        if os.path.exists(os.path.join(full, ".git")):
            repos.append(describe_repo(full, ws))
    data = {"workspace": ws, "repos": repos}
    if a.json:
        return 0, [json.dumps(data, indent=2)]
    if not repos:
        return 0, ["no repos found under %s" % ws]
    out = ["| Repo | Branch @ HEAD | Dirty | Package manager | Lockfiles | Scripts | CI | Specs (dup prefixes) | Spec Kit | Agent surfaces | Context |",
           "|---|---|---|---|---|---|---|---|---|---|---|"]
    for r in repos:
        dups = ", ".join(sorted(r["specs"]["duplicates"])) or "-"
        c = r["context"]
        ctx = "-" if c is None else ("STALE (%s behind)" % (c["commits_behind"] if c["commits_behind"] is not None else "?")
                                     if c["stale"] else "fresh")
        out.append("| %s | %s @ %s | %d | %s | %s | %s | %d | %d (%s) | %s | %s | %s |" % (
            r["name"], r["branch"] or "-", r["head"] or "-", r["dirty"], r["package_manager"] or "-",
            ", ".join(r["lockfiles"]) or "-", ", ".join(r["scripts"]) or ", ".join(r["manifests"]) or "-",
            r["ci_workflows"], r["specs"]["count"], dups, r["speckit_version"] or "-",
            ", ".join(r["surfaces"]) or "-", ctx))
    return 0, out


# ---------------------------------------------------------------- lint

REF_RE = re.compile(r"\.sdlc/([A-Za-z0-9_./-]*)")


def lint_refs(kit, text, label, errors, kit_paths):
    for m in REF_RE.finditer(text):
        if text[m.end():m.end() + 1] in ("*", "<"):
            continue  # glob or placeholder, not a concrete path
        ref = m.group(1).rstrip(".,;:").rstrip("/")
        if not ref or ref in ("config.json", "lock.json", "workspace.md") or ref.startswith(("context", "decisions", "drafts", "bugs", "evals", "evidence")):
            continue
        if ref not in kit_paths:
            errors.append("%s: references missing .sdlc/%s" % (label, ref))


def kit_sdlc_paths(kit):
    paths = {"constitution.md"}

    def add(prefix, root):
        if os.path.isdir(root):
            paths.add(prefix)
            for f in list_files(root):
                paths.add(prefix + "/" + f)
                parts = f.split("/")
                for i in range(1, len(parts)):
                    paths.add(prefix + "/" + "/".join(parts[:i]))

    add("principles", os.path.join(kit, "core", "principles"))
    mods = os.path.join(kit, "modules")
    roots = [os.path.join(kit, "core")]
    if os.path.isdir(mods):
        roots += [os.path.join(mods, m) for m in sorted(os.listdir(mods))]
    for r in roots:
        for k in SHARED_DIRS:
            add(k, os.path.join(r, k))
    return paths


def constitution_skills(kit):
    sdir = os.path.join(kit, "core", "skills")
    path = os.path.join(kit, "core", "constitution.md")
    if not (os.path.isdir(sdir) and os.path.isfile(path)):
        return set()
    return {n for n in re.findall(r"`([a-z0-9-]+)`", read_text(path)) if n in set(os.listdir(sdir))}


def lint_trigger_evals(kit, errors):
    # A constitution rule that names a skill is only proven by an eval whose prompt doesn't name it.
    named = sorted(constitution_skills(kit))
    path = os.path.join(kit, "evals", "scenarios.md")
    rows = []
    if os.path.isfile(path):
        for line in read_text(path).split("\n"):
            cells = [c.strip() for c in line.strip().strip("|").split("|")]
            if line.startswith("|") and len(cells) >= 3:
                rows.append((cells[1], cells[-1]))
    for n in named:
        word = re.compile(r"(?<![\w-])%s(?![\w-])" % re.escape(n))
        if not any("Loads `%s`" % n in expect and not word.search(prompt) for prompt, expect in rows):
            errors.append("core/constitution.md: `%s` has no eval row whose prompt doesn't name it and whose Expect says Loads `%s` (evals/scenarios.md)" % (n, n))


def lint_frontmatter(fm, errs, label, allowed, errors):
    errors += ["%s: %s" % (label, e) for e in errs]
    for k in fm:
        if k not in allowed:
            errors.append("%s: unknown frontmatter key %s" % (label, k))


def cmd_lint(a, kit):
    errors = []
    paths = kit_sdlc_paths(kit)
    roots = [os.path.join(kit, "core")]
    mods = os.path.join(kit, "modules")
    if os.path.isdir(mods):
        roots += [os.path.join(mods, m) for m in sorted(os.listdir(mods)) if os.path.isdir(os.path.join(mods, m))]
    if not os.path.isfile(os.path.join(kit, "core", "constitution.md")):
        errors.append("core/constitution.md: missing")
    else:
        lint_trigger_evals(kit, errors)
    if not os.path.isfile(os.path.join(kit, "VERSION")):
        errors.append("VERSION: missing")
    for root in roots:
        rl = os.path.relpath(root, kit)
        rules = os.path.join(root, "rules.md")
        if rl != "core" and os.path.isfile(rules):
            label = "%s/rules.md" % rl
            text = read_text(rules)
            n = len(text.split("\n")) - (1 if text.endswith("\n") else 0)
            if n > 30:
                errors.append("%s: %d lines (max 30)" % (label, n))
            lint_refs(kit, text, label, errors, paths)
        sdir = os.path.join(root, "skills")
        if os.path.isdir(sdir):
            for name in sorted(os.listdir(sdir)):
                d = os.path.join(sdir, name)
                if not os.path.isdir(d):
                    continue
                label = "%s/skills/%s/SKILL.md" % (rl, name)
                sk = os.path.join(d, "SKILL.md")
                if not os.path.isfile(sk):
                    errors.append("%s: missing" % label)
                    continue
                text = read_text(sk)
                fm, _, errs = parse_frontmatter(text)
                lint_frontmatter(fm, errs, label, SKILL_KEYS, errors)
                if fm.get("name") != name:
                    errors.append("%s: name %r must equal folder %r" % (label, fm.get("name"), name))
                desc = fm.get("description")
                if not isinstance(desc, str) or not desc:
                    errors.append("%s: description required" % label)
                elif len(desc) > 1024:
                    errors.append("%s: description exceeds 1024 chars" % label)
                if rl == "core" and fm.get("disable-model-invocation") is True and name in constitution_skills(kit):
                    errors.append("%s: named in core/constitution.md but disable-model-invocation is true" % label)
                for k in SKILL_BOOLS:
                    if k in fm and not isinstance(fm[k], bool):
                        errors.append("%s: %s must be true or false" % (label, k))
                if "argument-hint" in fm and not isinstance(fm["argument-hint"], str):
                    errors.append("%s: argument-hint must be a string" % label)
                present = {l.rstrip() for l in text.split("\n")}
                for sec in SKILL_SECTIONS:
                    if sec not in present:
                        errors.append("%s: missing section '%s'" % (label, sec))
                n = len(text.split("\n")) - (1 if text.endswith("\n") else 0)
                if n > 200:
                    errors.append("%s: %d lines (max 200)" % (label, n))
                for f in list_files(d):
                    if f.endswith(".md"):
                        lint_refs(kit, read_text(os.path.join(d, f)), "%s/skills/%s/%s" % (rl, name, f), errors, paths)
        rdir = os.path.join(root, "roles")
        if os.path.isdir(rdir):
            for f in sorted(os.listdir(rdir)):
                if not f.endswith(".md"):
                    continue
                label = "%s/roles/%s" % (rl, f)
                text = read_text(os.path.join(rdir, f))
                fm, _, errs = parse_frontmatter(text)
                lint_frontmatter(fm, errs, label, ROLE_KEYS, errors)
                if fm.get("name") != f[:-3]:
                    errors.append("%s: name %r must equal file stem %r" % (label, fm.get("name"), f[:-3]))
                if not isinstance(fm.get("description"), str) or not fm.get("description"):
                    errors.append("%s: description required" % label)
                if fm.get("access") not in ("read-only", "full"):
                    errors.append("%s: access must be read-only or full" % label)
                if "checks" in fm:  # spec 010: a read-only reviewer that may run the project's check commands
                    if fm["checks"] is not True and fm["checks"] is not False:
                        errors.append("%s: checks must be true or false" % label)
                    elif fm.get("access") != "read-only":
                        errors.append("%s: checks is only valid on a read-only role" % label)
                lint_refs(kit, text, label, errors, paths)
    for e in errors:
        print("ERROR " + e)
    print("lint: %s" % ("%d error(s)" % len(errors) if errors else "ok"))
    return (1 if errors else 0), None


# ---------------------------------------------------------------- main

def build_parser():
    p = argparse.ArgumentParser(prog="sdlc", description="Render the sdlc-kit into a project.")
    p.add_argument("--kit", help="kit root (default: parent of bin/)")
    sub = p.add_subparsers(dest="cmd", metavar="command")
    sub.required = True

    def add(name, fn, help_, dir_=True):
        sp = sub.add_parser(name, help=help_, description=help_)
        sp.add_argument("--kit", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
        if dir_:
            sp.add_argument("dir", help="project directory (must exist)")
        sp.set_defaults(fn=fn)
        return sp

    sp = add("install", cmd_install, "Render the kit into a project (acts as update if already installed).")
    sp.add_argument("--targets", help="comma list of: claude,copilot (default: both, or lock)")
    sp.add_argument("--modules", help="comma list of kit modules, e.g. qa")
    sp.add_argument("--force", action="store_true", help="overwrite conflicting or locally modified files")
    sp = add("update", cmd_update, "Re-render using the targets and modules in the lock.")
    sp.add_argument("--force", action="store_true", help="overwrite locally modified files")
    add("check", cmd_check, "Report drift, duplicate specs and outdated installs.")
    add("uninstall", cmd_uninstall, "Remove unmodified managed files and blocks; keep config.json.")
    add("next-spec", cmd_next_spec, "Print the next free 3-digit spec prefix.")
    sp = add("verify", cmd_verify, "Run the configured commands once and write .sdlc/evidence/verify.json.")
    sp.add_argument("--repo", help="workspace repo name (uses repos.<name>.commands)")
    sp = add("gate", cmd_gate, "Mechanical readiness checks: approved, approve, green-at-head, evidence-for-ticks.", dir_=False)
    sp.add_argument("name", help="approved | approve | green-at-head | evidence-for-ticks")
    sp.add_argument("dir", help="project directory (must exist)")
    sp.add_argument("--spec", help="feature: NNN or a folder inside spec_dir")
    sp.add_argument("--repo", help="workspace repo name")
    sp.add_argument("--by", help="approver's name (approve only)")
    sp = add("budget", cmd_budget, "Compare the diff and a unit's turns with budget.* (read-only).")
    sp.add_argument("--repo", help="workspace repo name")
    sp.add_argument("--base", help="branch, tag or commit to measure from (default: origin/HEAD, main or master)")
    sp.add_argument("--unit", help="task or finding id whose recorded turns are compared (needs --spec)")
    sp.add_argument("--spec", help="feature NNN or folder holding the tasks.md with the usage line (needs --unit)")
    sp = add("hook", cmd_hook, "Run an enforcement hook; reads the host's JSON on standard input (spec 006).", dir_=False)
    sp.add_argument("name", choices=["bash", "edit", "stop"])
    sp = add("discover", cmd_discover, "List the git repos directly under a workspace folder (read-only).")
    sp.add_argument("--json", action="store_true", help="machine-readable output")
    add("lint", cmd_lint, "Validate the kit itself.", dir_=False)
    return p


def main(argv=None):
    a = build_parser().parse_args(argv)
    kit = os.path.abspath(a.kit) if a.kit else os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    try:
        code, lines = a.fn(a, kit)
    except SdlcError as e:
        print("sdlc: error: %s" % e, file=sys.stderr)
        return 1
    for l in lines or []:
        print(l)
    return code


if __name__ == "__main__":
    sys.exit(main())
